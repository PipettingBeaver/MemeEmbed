{
  "name": "MemeEmbed",
  "short_name": "MemeEmbed",
  "description": "Embed images into meme templates with perspective quads, color matching, edge blending, and rounded bevels.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#080a0e",
  "theme_color": "#0c1117",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
